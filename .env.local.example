REACT_EDITOR=code

# Supabase — publiczne (bezpieczne w przeglądarce)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# CRED — wyłącznie serwerowe (NIE dodawaj prefiksu NEXT_PUBLIC_!)
CRED_API_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
CRED_TOKEN=your_32_char_token_here

# Supabase — wyłącznie serwerowe (NIE dodawaj prefiksu NEXT_PUBLIC_!)
# WYMAGANE w produkcji — bez tego klucza powiadomienia i deadline-check nie działają
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Secret dla zewnętrznego endpointu powiadomień (/api/notifications/external)
# Używany przez formularz /wniosek — nie jest sekretem sesji użytkownika
# Wygeneruj losowy ciąg: openssl rand -hex 32
EXTERNAL_NOTIFICATIONS_SECRET=your_external_notifications_secret_min_32_chars

# Secret dla crona deadline-check (/api/notifications/deadline-check)
# Wymagany — endpoint bez tego zwraca 500
# Vercel Cron musi wysyłać: Authorization: Bearer $CRON_SECRET
CRON_SECRET=your_cron_secret_min_32_chars
