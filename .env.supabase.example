# Skopiuj jako .env.supabase (plik jest w .gitignore).
# Token konta Supabase z dostępem do projektu AdminOS (ref mutflmihoxndxefuxsno):
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Hasło bazy (Project Settings → Database); potrzebne tylko do `link` i `db push`.
SUPABASE_DB_PASSWORD=
